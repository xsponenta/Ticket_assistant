# Copy to .env (gitignored) and fill in. Never commit .env.

# Required: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: Langfuse tracing is enabled only when both keys are set (and `pip install langfuse`).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
